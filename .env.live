# Book Worm — Live mode environment variables
# Used when running `npm run dev:live` or `npm run test:e2e:live`

VITE_API_MODE=live
VITE_MEDUSA_URL=http://localhost:9100
# VITE_MEDUSA_PUBLISHABLE_KEY and VITE_MEDUSA_REGION_ID change with every seeded database:
# `npm run live:env` writes them to .env.live.local (git-ignored).
