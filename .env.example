# Copy to .env.local and adjust. Mock mode needs none of these.

# mock (default): the API is served by MSW in the browser, no backend needed
# live: talk to the Medusa backend in backend/ (see docs/plans/14-backend-medusa.md)
VITE_API_MODE=mock

# Live mode only
VITE_MEDUSA_URL=http://localhost:9100
VITE_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_key_from_medusa_admin
VITE_MEDUSA_REGION_ID=reg_replace_with_india_region_id
